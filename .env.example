# Neon Postgres — copy from your Neon project dashboard (use the pooled connection string)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-west-2.aws.neon.tech/stredar?sslmode=require

# Secret shared with all deployed Stredar units — used to authenticate ingest requests
INGEST_SECRET=change-me-to-a-long-random-string

# Resend API key — https://resend.com/api-keys
# Domain stredar.uk must be verified in the Resend dashboard before emails send correctly
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Admin auth (NextAuth v5)
# Generate AUTH_SECRET:        npx auth secret
# Generate password hash:      node -e "const b=require('bcryptjs');b.hash('yourpassword',12).then(console.log)"
# IMPORTANT: in .env.local (not here), Next's env loader expands $VAR syntax, which mangles
# bcrypt hashes. Escape every $ as \$ in your real .env.local, e.g. \$2b\$12\$..., or admin
# login will fail with CredentialsSignin even with the correct password.
AUTH_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@stredar.uk
ADMIN_PASSWORD_HASH=$2b$12$placeholder-replace-with-real-hash

# Anthropic API key — used to draft the narrative text for /manage comparison reports
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
# Optional: override the model used for report narratives (defaults to claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5
